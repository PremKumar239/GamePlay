# Local PostgreSQL (pgAdmin). Replace YOUR_PASSWORD with the postgres password
# you set during PostgreSQL install. If the database name is lowercase, use gameplay.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/Gameplay

# First admin account is created automatically if the admins table is empty.
ADMIN_EMAIL=admin@gameplay.local
ADMIN_PASSWORD=GamePlay123!
ADMIN_SESSION_SECRET=change-this-to-a-long-random-string
